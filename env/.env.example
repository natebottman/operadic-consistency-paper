# Copy this file to env/.env and fill in your own keys.
# Required only for full inference reproduction (`scripts/run_all_inference.sh`).
# The cached CSVs in data/per_question/ are sufficient to reproduce all paper
# numbers via `scripts/reproduce_paper.sh` without API access.

# LLM inference
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Paths (absolute or relative to repo root)
EXP_ROOT=./experiments
DATA_ROOT=./data
